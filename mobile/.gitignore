# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — real values aren't secrets (public OAuth client
# metadata + a plain API URL), but kept out of git anyway, same
# never-commit-apply-specific-config discipline the Go/Terraform side
# uses (SSM, not files) — see .env.example for the template.
.env
.env*.local

# typescript
*.tsbuildinfo

# create-expo-app's generated Claude Code plugin registration and this
# session's scratch dev-server logs — neither belongs in the repo.
.claude/
expo-web.log
expo-web-err.log

# generated native folders
/ios
/android
