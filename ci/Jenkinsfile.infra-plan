// docs/design.md §10: PR touching infra/**
//   fmt -check -> validate -> tfsec -> checkov -> plan -> post plan as artifact
//
// Push-triggered rather than true PR-discovery for now — see ci/jobs.groovy
// for why (needs GitHub credentials this seed doesn't have yet).
//
// pollSCM, not githubPush(): GitHub's webhook servers can't reach this
// Jenkins (its ALB is IP-locked to the operator only, §10) — see
// ci/Jenkinsfile.api-build's comment for the full rationale.
pipeline {
    agent { label 'fargate-agent' }

    options {
        timestamps()
        ansiColor('xterm')
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        AWS_REGION = 'us-west-1'
    }

    stages {
        stage('fmt check') {
            steps {
                dir('infra/terraform') { sh 'terraform fmt -recursive -check' }
            }
        }
        stage('validate') {
            steps {
                dir('infra/terraform/envs/dev-compute') {
                    sh 'terraform init -backend=false'
                    sh 'terraform validate'
                }
            }
        }
        stage('tfsec') {
            steps { sh 'tfsec infra/terraform' }
        }
        stage('checkov') {
            steps { sh 'checkov -d infra/terraform --compact' }
        }
        stage('plan') {
            steps {
                dir('infra/terraform/envs/dev-compute') {
                    // terraform.tfvars is deliberately gitignored (real
                    // operator IP/email, not something to commit to a
                    // public repo) so it never reaches this checkout —
                    // confirmed against a real first run of infra-apply,
                    // which failed outright on missing required variables.
                    // Same SSM-as-source-of-apply-specific-values pattern
                    // already used for the Jenkins admin password and the
                    // API URL.
                    sh '''
                      jq -n \
                        --arg jenkins_allowed_cidr "$(aws ssm get-parameter --name /job-syllabus/terraform/jenkins_allowed_cidr --region "$AWS_REGION" --query Parameter.Value --output text)" \
                        --arg alert_email "$(aws ssm get-parameter --name /job-syllabus/terraform/alert_email --region "$AWS_REGION" --query Parameter.Value --output text)" \
                        --argjson restore_from_snapshot "$(aws ssm get-parameter --name /job-syllabus/terraform/restore_from_snapshot --region "$AWS_REGION" --query Parameter.Value --output text)" \
                        '{jenkins_allowed_cidr:$jenkins_allowed_cidr, alert_email:$alert_email, restore_from_snapshot:$restore_from_snapshot}' \
                        > terraform.tfvars.json
                    '''
                    sh 'terraform init'
                    sh 'terraform plan -out=tfplan'
                }
                archiveArtifacts artifacts: 'infra/terraform/envs/dev-compute/tfplan', fingerprint: true
            }
        }
    }
}
