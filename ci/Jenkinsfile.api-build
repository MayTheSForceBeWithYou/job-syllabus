// docs/design.md §10: push to main, path cmd/**, internal/**
//   go vet -> golangci-lint -> go test -race -cover -> extraction
//   validation gate -> build (multi-stage -> distroless) -> Trivy
//   (fail on HIGH+) -> ECR push tagged $GIT_SHA -> ecs update-service
//   -> poll stability -> smoke test /healthz
//
// Deploy + smoke-test are live as of Phase 3 (service-api exists now).
//
// pollSCM, not githubPush(): a GitHub webhook can't reach this Jenkins —
// its ALB is IP-locked to the operator only (docs/design.md §10, "never
// expose Jenkins to the open internet"), so GitHub's webhook servers get
// nothing back. Jenkins polling GitHub itself needs no inbound
// connectivity at all and still gets a build running within minutes of a
// push, which is what "deployed... from a git push" (§13 Phase 3 DoD)
// actually requires.
pipeline {
    agent { label 'fargate-agent' }

    options {
        timestamps()
        ansiColor('xterm')
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        AWS_REGION      = 'us-west-1'
        ECR_REPO        = '881811711506.dkr.ecr.us-west-1.amazonaws.com/job-syllabus/api'
        IMAGE_TAG       = "${env.GIT_COMMIT}"
        ECS_CLUSTER     = 'job-syllabus'
        ECS_SERVICE     = 'api'
        TASK_DEF_FAMILY = 'job-syllabus-api'
    }

    stages {
        stage('Vet') {
            steps { sh 'go vet ./...' }
        }
        stage('Lint') {
            steps { sh 'golangci-lint run ./...' }
        }
        stage('Test') {
            steps { sh 'go test -race -cover ./...' }
        }
        stage('Extraction validation gate') {
            // §6: fails below 90% precision — the same gate `make test`
            // runs locally, run again here so a bad skills.yaml/matcher
            // change can't merge without CI catching it.
            steps { sh 'go test ./internal/extract/... -run TestExtractionPrecisionRecall -v' }
        }
        stage('Build image') {
            // Its own dedicated, minimal agent — not the fargate-agent
            // every other stage runs on. Kaniko has no daemon/overlayfs
            // isolation, so it unpacks the built image's base rootfs
            // directly onto whatever container it's running in; sharing
            // that container with a live JNLP process and a dozen other
            // CI tools on a heavily-overlapping Debian-family filesystem
            // repeatedly killed the agent mid-build (confirmed against
            // several otherwise fully green runs that died at the exact
            // same point every time, regardless of resource sizing) —
            // see ci/kaniko-agent.Dockerfile's header comment. A
            // different agent means a fresh checkout here too.
            agent { label 'kaniko-agent' }
            steps {
                checkout scm
                // Kaniko, not `docker buildx build`: no Docker daemon at
                // all (§10, no privileged DinD on Fargate) — confirmed
                // against a real CI run, which failed outright trying to
                // reach unix:///var/run/docker.sock. Kaniko builds and
                // pushes in userspace with no daemon involved; auth is a
                // plain docker-config.json written by hand (no
                // `docker login` client to run either) using the same
                // ECR password every other stage already fetches via the
                // AWS CLI.
                //
                // returnStatus, not the default fail-on-nonzero: Kaniko's
                // own between-stage filesystem reset (this Dockerfile is
                // multi-stage, build -> distroless) deletes everything not
                // explicitly protected, which reliably breaks the Durable
                // Task Plugin's own post-completion bookkeeping — a real
                // run confirmed the build+push finishes correctly (a real
                // digest landed in ECR) but Jenkins still marked the stage
                // FAILURE ~8 minutes later because the wrapper's own
                // mv/sh-dependent completion signal never arrived. Trying
                // to protect those binaries with --ignore-path doesn't
                // work either: a further real run showed --ignore-path
                // also blocks Kaniko from unpacking a base image's own
                // content into an ignored path, so protecting /usr broke
                // `go mod download` outright ("go: not found") — the build
                // stage's own golang:1.26-bookworm toolchain never landed.
                // Instead of fighting Kaniko's process model further, this
                // stage's own exit status is treated as unreliable; the
                // next stage verifies the push independently against ECR,
                // the actual source of truth.
                script {
                    def status = sh(returnStatus: true, script: '''
                      mkdir -p /kaniko/.docker
                      ECR_HOST="${ECR_REPO%%/*}"
                      AUTH=$(printf "AWS:%s" "$(aws ecr get-login-password --region "$AWS_REGION")" | base64 -w0)
                      printf '{"auths":{"%s":{"auth":"%s"}}}' "$ECR_HOST" "$AUTH" > /kaniko/.docker/config.json
                      # --single-snapshot: one full-filesystem snapshot at
                      # the end instead of one per Dockerfile instruction —
                      # this Dockerfile only has 2 RUN/COPY pairs, so most
                      # of that per-instruction snapshotting was pure
                      # overhead. --ignore-path=/home/jenkins protects the
                      # JNLP agent's own workspace/jar cache from Kaniko's
                      # between-stage filesystem wipe; it is not, and
                      # cannot be, a complete fix (see above).
                      /kaniko/executor --dockerfile=Dockerfile --context="dir://$(pwd)" \
                        --destination="$ECR_REPO:$IMAGE_TAG" --build-arg=BINARY=api --cache=false \
                        --single-snapshot --ignore-path=/home/jenkins
                    ''')
                    echo "Kaniko step exited ${status} — this can be a false failure if the JNLP wrapper died after a successful push; the next stage verifies against ECR directly."
                }
            }
        }
        stage('Verify image pushed') {
            // The authoritative success signal for the Build image stage
            // — its own exit status can't be trusted (see above), but a
            // real image digest actually landing in ECR can't be faked by
            // a dead agent connection. Runs on the ordinary fargate-agent,
            // not kaniko-agent, since that agent's task may already be
            // gone by the time this stage starts.
            steps {
                sh '''
                  for i in $(seq 1 20); do
                    if aws ecr describe-images --repository-name job-syllabus/api \
                        --image-ids imageTag="$IMAGE_TAG" --region "$AWS_REGION" >/dev/null 2>&1; then
                      echo "Found $ECR_REPO:$IMAGE_TAG in ECR"
                      exit 0
                    fi
                    sleep 15
                  done
                  echo "Image $ECR_REPO:$IMAGE_TAG never appeared in ECR" >&2
                  exit 1
                '''
            }
        }
        stage('Trivy scan') {
            steps {
                sh 'trivy image --severity HIGH,CRITICAL --exit-code 1 "$ECR_REPO:$IMAGE_TAG"'
            }
        }
        stage('Deploy') {
            steps {
                // Terraform (modules/service-api) owns the task definition's
                // *shape* (cpu/memory/roles/log config) and deliberately
                // ignore_changes on container_definitions/task_definition
                // so it doesn't fight this — every real deploy after the
                // first comes from here: describe the current (Terraform- or
                // previously-Jenkins-registered) revision, swap only the
                // image, register a new revision, point the service at it.
                // Plain `--force-new-deployment` on its own would restart
                // the service on the SAME image tag it already had, not
                // this build's — that was the original Phase 2 stub's bug.
                sh '''
                  aws ecs describe-task-definition --task-definition "$TASK_DEF_FAMILY" --region "$AWS_REGION" \
                    --query 'taskDefinition' > current-task-def.json

                  # describe-task-definition's output has several read-only
                  # fields register-task-definition's --cli-input-json
                  # rejects outright ("Unknown parameter") — strip all of
                  # them, not just the ones likely to be present.
                  jq --arg IMAGE "$ECR_REPO:$IMAGE_TAG" \
                    '.containerDefinitions[0].image = $IMAGE
                     | del(.taskDefinitionArn, .revision, .status, .requiresAttributes,
                           .compatibilities, .registeredAt, .registeredBy, .deregisteredAt)' \
                    current-task-def.json > new-task-def.json

                  NEW_REVISION_ARN=$(aws ecs register-task-definition --region "$AWS_REGION" \
                    --cli-input-json file://new-task-def.json \
                    --query 'taskDefinition.taskDefinitionArn' --output text)

                  echo "Registered $NEW_REVISION_ARN"

                  aws ecs update-service --cluster "$ECS_CLUSTER" --service "$ECS_SERVICE" \
                    --task-definition "$NEW_REVISION_ARN" --region "$AWS_REGION"
                  aws ecs wait services-stable --cluster "$ECS_CLUSTER" --services "$ECS_SERVICE" --region "$AWS_REGION"
                '''
            }
        }
        stage('Smoke test') {
            steps {
                // The API's URL is Terraform-published to SSM (modules/
                // api-gateway), not hardcoded here — it's a real
                // apply-specific value (the API Gateway default endpoint),
                // same "SSM as the source of dynamic values" pattern the
                // Jenkins admin password already uses.
                sh '''
                  API_URL=$(aws ssm get-parameter --name /job-syllabus/api/url --region "$AWS_REGION" --query Parameter.Value --output text)
                  curl -fsS "$API_URL/healthz"
                '''
            }
        }
    }
}
