// docs/design.md §10: manual, after infra-plan
//   input approval -> apply
//
// Re-runs `terraform plan` fresh immediately before applying (rather than
// reusing infra-plan's artifact via the copyArtifacts plugin, which isn't
// in ci/plugins.txt) so the approved plan can never be stale by the time
// it's actually applied — the `input` step shows this run's plan output,
// not a plan from an earlier build.
//
// Known caveat worth being upfront about (see docs/phase-2.md): this job
// runs ON the Jenkins EC2 instance that IS part of dev-compute. An apply
// that replaces the Jenkins instance itself would kill the pipeline
// mid-run. Not solved here — noted as a real limitation of Jenkins
// self-managing its own infra, not a bug to silently work around.
pipeline {
    agent { label 'fargate-agent' }

    options {
        timestamps()
        ansiColor('xterm')
    }

    // No automatic triggers, deliberately — manual only.

    environment {
        AWS_REGION = 'us-west-1'
    }

    stages {
        stage('plan') {
            steps {
                dir('infra/terraform/envs/dev-compute') {
                    // terraform.tfvars is deliberately gitignored (real
                    // operator IP/email, not something to commit to a
                    // public repo) so it never reaches this checkout —
                    // confirmed against a real first run of this job,
                    // which failed outright on missing required variables.
                    // Same SSM-as-source-of-apply-specific-values pattern
                    // already used for the Jenkins admin password and the
                    // API URL. See ci/Jenkinsfile.infra-plan's identical
                    // step for the fuller rationale.
                    sh '''
                      jq -n \
                        --arg jenkins_allowed_cidr "$(aws ssm get-parameter --name /job-syllabus/terraform/jenkins_allowed_cidr --region "$AWS_REGION" --query Parameter.Value --output text)" \
                        --arg alert_email "$(aws ssm get-parameter --name /job-syllabus/terraform/alert_email --region "$AWS_REGION" --query Parameter.Value --output text)" \
                        --argjson restore_from_snapshot "$(aws ssm get-parameter --name /job-syllabus/terraform/restore_from_snapshot --region "$AWS_REGION" --query Parameter.Value --output text)" \
                        '{jenkins_allowed_cidr:$jenkins_allowed_cidr, alert_email:$alert_email, restore_from_snapshot:$restore_from_snapshot}' \
                        > terraform.tfvars.json
                    '''
                    sh 'terraform init'
                    sh 'terraform plan -out=tfplan -detailed-exitcode || true'
                    sh 'terraform show -no-color tfplan > tfplan.txt'
                    // Relative to this dir() block, not the workspace root
                    // — the doubled prefix here failed a real run outright
                    // ("doesn't match anything, but 'tfplan.txt' does").
                    archiveArtifacts artifacts: 'tfplan.txt', fingerprint: true
                }
            }
        }
        stage('approve') {
            steps {
                script {
                    def planText = readFile('infra/terraform/envs/dev-compute/tfplan.txt')
                    input message: "Apply this plan?", parameters: [text(name: 'Plan', defaultValue: planText)]
                }
            }
        }
        stage('apply') {
            steps {
                dir('infra/terraform/envs/dev-compute') {
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }
    }
}
